<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="campus_delivery_world">
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
    </scene>

    <model name="central_mail_room">
      <pose>-1.7 -1.7 0.5 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>1.8 1.2 1.0</size></box></geometry>
          <material><ambient>0.1 0.45 0.85 1</ambient><diffuse>0.1 0.45 0.85 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>1.8 1.2 1.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="library">
      <pose>5 2 0.75 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>2.0 1.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.25 0.2 1</ambient><diffuse>0.8 0.25 0.2 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>2.0 1.5 1.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="engineering_lab">
      <pose>-4 3.5 0.75 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>2.2 1.4 1.5</size></box></geometry>
          <material><ambient>0.18 0.65 0.35 1</ambient><diffuse>0.18 0.65 0.35 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>2.2 1.4 1.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="admin_block">
      <pose>3 -4 0.7 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>1.8 1.8 1.4</size></box></geometry>
          <material><ambient>0.85 0.72 0.18 1</ambient><diffuse>0.85 0.72 0.18 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>1.8 1.8 1.4</size></box></geometry></collision>
      </link>
    </model>

    <model name="hostel">
      <pose>-5 -3 0.65 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>2.0 1.6 1.3</size></box></geometry>
          <material><ambient>0.55 0.35 0.85 1</ambient><diffuse>0.55 0.35 0.85 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>2.0 1.6 1.3</size></box></geometry></collision>
      </link>
    </model>

    <model name="cafeteria">
      <pose>0 5 0.6 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><box><size>2.3 1.3 1.2</size></box></geometry>
          <material><ambient>0.95 0.45 0.12 1</ambient><diffuse>0.95 0.45 0.12 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>2.3 1.3 1.2</size></box></geometry></collision>
      </link>
    </model>

    <model name="road_north_south">
      <pose>0 0 0.011 0 0 0</pose>
      <static>true</static>
      <link name="road">
        <visual name="visual">
          <geometry><box><size>1.0 12.0 0.02</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="road_east_west">
      <pose>0 0 0.012 0 0 0</pose>
      <static>true</static>
      <link name="road">
        <visual name="visual">
          <geometry><box><size>12.0 1.0 0.02</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="courtyard_obstacle">
      <pose>1.8 1.4 0.35 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.7</length></cylinder></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
